// Rate() - инициирует запрос к игровой площадке на оценку игры.
public void Rate();
```


- 4.8. IRemote - Удаленный конфиг

  > **IRemote** - набор параметров, который подгружается при запуске игры через площадку.
С помощью этого сервиса можно изменять параметры игры, не изменяя при этом билд.

  ---

  При использовании этого сервиса для каждого параметра в ***Keys.cs*** заводится enum-значение в **RemoteKey** с соответствующим названием.

  ### Интерфейс сервиса

  ```C#
// Rate() - инициирует запрос к игровой площадке на оценку игры.
protected Dictionary<RemoteKey, string> Values { get; }

// GetString() - возвращает значение из конфига в формате строки. 
// В случае отсутствия в конфиге данного значения будет использоваться defaultValue.
public string GetString(RemoteKey remoteKey, string defaultValue = "");

// GetBool() - возвращает значение из конфига в формате bool.
// В самом конфиге такое значение должно быть как строка либо "False", либо "True".
// В случае отсутствия в конфиге данного значения будет использоваться defaultValue.
public bool GetBool(RemoteKey remoteKey, bool defaultValue = false)

// GetInt() - возвращает значение из конфига в формате целого числа. 
// В случае отсутствия в конфиге данного значения будет использоваться defaultValue.
public int GetInt(RemoteKey remoteKey, int defaultValue = 0);

// GetFloat() - возвращает значение из конфига в формате числа с плавающей точкой. 
// В случае отсутствия в конфиге данного значения будет использоваться defaultValue.
public float GetFloat(RemoteKey remoteKey, float defaultValue = 0f);

// KeyExists() - возвращает true, если параметр с заданным ключом существует.
public bool KeyExists(RemoteKey remoteKey) => Values.ContainsKey(remoteKey);
```


